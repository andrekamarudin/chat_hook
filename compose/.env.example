# Seed via Infisical at deploy time. Never commit actual secrets.
CHAT_HOOK_SOURCES_JSON={"waha":"CHANGE_ME_TO_RANDOM_32_PLUS_CHARACTER_SECRET"}
CHAT_HOOK_ADMIN_TOKEN=CHANGE_ME_TO_RANDOM_32_PLUS_CHARACTER_SECRET

# Optional direct OpenAI Decisions API key, stored ONLY in Infisical.
OPENAI_API_KEY=CHANGE_ME_OPENAI_SECRET
CHAT_HOOK_IGNORE_THRESHOLD=0.10
CHAT_HOOK_WAKE_THRESHOLD=0.80

# Secret stored in Infisical; 32+ random characters, never commit its real value.
CHAT_HOOK_SOURCE_ROOT=CHANGE_ME_LONG_RANDOM_SECRET

# MCP / OAuth surface (Infisical only). The public URL is set in compose.
# Fernet key material for callback secrets at rest; 32+ random characters.
CHAT_HOOK_DATA_KEY=CHANGE_ME_TO_RANDOM_32_PLUS_CHARACTER_SECRET
# Single-owner consent password for ChatGPT OAuth; 32+ random characters.
CHAT_HOOK_OWNER_PASSWORD=CHANGE_ME_TO_RANDOM_32_PLUS_CHARACTER_SECRET
CHAT_HOOK_OWNER=owner
# Category that receives daily reports and audit requests.
CHAT_HOOK_REPORT_CATEGORY=personal
CHAT_HOOK_WORKER_INTERVAL=15
